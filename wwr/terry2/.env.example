# Copy to .env (or set these in your host's dashboard) when you run server.js.
# Only needed if you want the TMDB key hidden from the browser.
# Get them at https://www.themoviedb.org/settings/api

# Either the short v3 key...
TMDB_API_KEY=

# ...or the long v4 read access token (starts with eyJ). Token wins if both are set.
TMDB_READ_TOKEN=

# Used for "in cinemas now" and "where to watch"
TMDB_REGION=UG

# Port for local runs
PORT=3000
